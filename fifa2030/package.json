{
  "name": "fifa2030-intro",
  "version": "1.0.0",
  "private": true,
  "description": "FIFA World Cup 2030 broadcast title sequence — 90s, Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "tsc --noEmit",
    "render": "remotion render FIFA2030Intro out/fifa2030.mp4",
    "render:vertical": "remotion render FIFA2030Intro-Vertical out/fifa2030-vertical.mp4",
    "render:square": "remotion render FIFA2030Intro-Square out/fifa2030-square.mp4",
    "preview": "remotion render FIFA2030Intro out/preview.mp4 --jpeg-quality=60 --scale=0.5",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@remotion/cli": "4.0.503",
    "@remotion/google-fonts": "4.0.503",
