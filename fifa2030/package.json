    "@remotion/paths": "4.0.503",
    "@remotion/shapes": "4.0.503",
    "@remotion/three": "4.0.503",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.503",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "typescript": "5.6.3"
