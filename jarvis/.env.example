# Copy to .env and fill in what you need. Everything is optional for local use.

# --- Server ---
PORT=3000
# Public URL of this server (used for OAuth redirect URIs)
JARVIS_BASE_URL=http://localhost:3000
# Required in production: 32+ random characters. Encrypts OAuth tokens at rest.
# JARVIS_SECRET=
# NODE_ENV=production
# JARVIS_DATA_DIR=./data            # where the SQLite database lives
# JARVIS_ALLOW_SIGNUP=true          # set false to stop new registrations
# JARVIS_SESSION_DAYS=14

# --- Reminder scheduler ---
# Runs inside the web server by default. If you run several web processes or a
# serverless host, set this to 1 there and run exactly one `npm run worker`.
# JARVIS_DISABLE_SCHEDULER=1
# JARVIS_SCHEDULER_INTERVAL_MS=30000

# --- AI provider (server-side only; never exposed to the browser) ---
# Anthropic (recommended)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low              # low | medium | high
# ANTHROPIC_FALLBACKS=true          # server-side refusal fallback (Claude API only)

# Or any OpenAI-compatible Chat Completions API
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI_MAX_TOOL_ROUNDS=8

# --- Google (Calendar + Gmail) OAuth ---
# Redirect URI: ${JARVIS_BASE_URL}/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Microsoft (Outlook Calendar + Mail) OAuth ---
# Redirect URI: ${JARVIS_BASE_URL}/api/integrations/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# --- Web search for research (pick one) ---
# TAVILY_API_KEY=
# BRAVE_API_KEY=
