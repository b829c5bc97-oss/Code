# Copy this file to `.env` in the `jarvis/` directory and fill in the values
# you need. Nothing here is required to get JARVIS running — every default
# below (AI_PROVIDER=mock, all tool categories on) needs no API key at all.

# --- General ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider ---
# One of: mock | openai | anthropic
AI_PROVIDER=mock
# Leave blank to use the provider's default model.
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent behaviour ---
MAX_HISTORY_MESSAGES=20
# Cap on tool-call round trips per turn (open browser -> navigate -> read, etc).
MAX_TOOL_STEPS=6
# Generate a short upfront plan for multi-step requests. Real providers only —
# the mock provider has no real reasoning to plan with, so it's a no-op there.
ENABLE_PLANNER=true

# --- Permissions ---
# HIGH-risk actions (deleting files, dangerous commands, ...) always require
# confirmation. Set this true to also require confirmation for MEDIUM-risk
# actions (writing files, clicking/typing on screen, running scripts) —
# useful if you want to review everything JARVIS does at first.
ALWAYS_CONFIRM_MEDIUM=false

# --- Browser automation ---
# Run `playwright install chromium` once after pip install.
ENABLE_BROWSER_TOOLS=true
# Visible by default so automation stays observable. Set true to run headless.
BROWSER_HEADLESS=false
# Leave blank to use Playwright's own bundled Chromium.
BROWSER_EXECUTABLE_PATH=
# Only needed on networks that require an upstream proxy for the browser itself.
BROWSER_PROXY_SERVER=

# --- Computer control (mouse/keyboard/screen/windows/apps) ---
ENABLE_COMPUTER_TOOLS=true

# --- File management ---
ENABLE_FILE_TOOLS=true
MAX_FILE_READ_CHARS=20000

# --- Coding assistant ---
ENABLE_CODE_TOOLS=true
# New projects/files JARVIS creates on its own initiative live here.
WORKSPACE_DIR=./workspace
CODE_RUN_TIMEOUT_SECONDS=60

# --- Documents (txt/md/csv/docx/pptx/xlsx/pdf) ---
ENABLE_DOCUMENT_TOOLS=true

# --- Long-term memory ---
ENABLE_MEMORY_TOOLS=true
MEMORY_FILE=./data/memory.json

# --- System monitor ---
ENABLE_SYSTEM_TOOLS=true
