# Copy this file to `.env` in the `jarvis/` directory and fill in the values
# you need. Nothing here is required to get JARVIS running — the defaults
# (AI_PROVIDER=mock, browser tools on) need no API key at all.

# --- General ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider ---
# One of: mock | openai | anthropic
AI_PROVIDER=mock
# Leave blank to use the provider's default model.
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent behaviour ---
MAX_HISTORY_MESSAGES=20
# Cap on tool-call round trips per turn (open browser -> navigate -> read, etc).
MAX_TOOL_STEPS=6

# --- Browser automation (Phase 3) ---
# Run `playwright install chromium` once after pip install.
ENABLE_BROWSER_TOOLS=true
# Visible by default so automation stays observable. Set true to run headless.
BROWSER_HEADLESS=false
# Leave blank to use Playwright's own bundled Chromium.
BROWSER_EXECUTABLE_PATH=
# Only needed on networks that require an upstream proxy for the browser itself.
BROWSER_PROXY_SERVER=
