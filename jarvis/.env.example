# Copy this file to `.env` in the `jarvis/` directory and fill in the values
# you need. Nothing here is required to get Phase 1 running — the default
# AI_PROVIDER=mock needs no API key at all.

# --- General ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider ---
# One of: mock | openai | anthropic
AI_PROVIDER=mock
# Leave blank to use the provider's default model.
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent behaviour ---
MAX_HISTORY_MESSAGES=20
