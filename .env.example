# Copy to .env (or just export these) before `npm start`.

# ---- AI ---------------------------------------------------------------------
# Without a key the pipeline still gathers, groups and ranks the news, but each
# briefing is a verbatim extract rather than a written summary. Get one at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for summarization, verification and cluster adjudication.
BRIEF_MODEL=claude-opus-5

# Effort is the main quality/cost dial. Summaries get the higher setting because
# that is where accuracy matters most; the utility calls are cheap by design.
BRIEF_SUMMARY_EFFORT=high
BRIEF_UTILITY_EFFORT=low

# ---- Server -----------------------------------------------------------------
PORT=3000
DB_PATH=./data/brief.db
LOG_LEVEL=info

# ---- Pipeline ---------------------------------------------------------------
# How often a full cycle runs, in minutes.
BRIEF_INTERVAL_MINUTES=15
# Run one cycle immediately on startup.
BRIEF_RUN_ON_START=true
# Only articles published inside this window can join a story.
BRIEF_CLUSTER_WINDOW_HOURS=72
# Articles older than this are dropped entirely.
BRIEF_RETENTION_DAYS=14

# ---- Cost control -----------------------------------------------------------
# Hard caps per cycle. Lower these to spend less; raise for broader coverage.
BRIEF_MAX_SUMMARIES=40
BRIEF_MAX_EXTRACTIONS=220
BRIEF_MAX_ADJUDICATIONS=60
# Second-pass fact-check of each briefing against its sources. Costs an extra
# call per story; turning it off means briefings ship unverified.
BRIEF_VERIFY=true

# ---- Clustering tuning ------------------------------------------------------
# Pairs at or above the join threshold merge automatically; pairs between the
# grey floor and that threshold are sent to the model to adjudicate.
BRIEF_JOIN_THRESHOLD=0.30
BRIEF_GREY_LOW=0.15

# ---- Politeness -------------------------------------------------------------
BRIEF_USER_AGENT=BriefNewsReader/1.0 (+https://github.com/brief-news)
BRIEF_PER_HOST_DELAY_MS=700
BRIEF_FEED_CONCURRENCY=8
BRIEF_ARTICLE_CONCURRENCY=6
