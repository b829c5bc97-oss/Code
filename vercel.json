{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "framework": null,
  "regions": [
    "pdx1"
  ],
  "functions": {
    "api/hq.mjs": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/hq?__p=/api/:path*"
    },
    {
      "source": "/m/:path*",
      "destination": "/api/hq?__p=/m/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/hq?__p=/mcp"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/hq?__p=/oauth/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/hq?__p=/.well-known/:path*"
    },
    {
      "source": "/internal/:path*",
      "destination": "/api/hq?__p=/internal/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self' https://claude.ai https://claude.com http://localhost:* http://127.0.0.1:*"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
